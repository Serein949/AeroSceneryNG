<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Dark palette ============ -->
    <Color x:Key="BgColor">#FF0B0E13</Color>
    <Color x:Key="PanelColor">#FF11151C</Color>
    <Color x:Key="CardColor">#FF161B24</Color>
    <Color x:Key="CardHoverColor">#FF1C2330</Color>
    <Color x:Key="BorderColor">#FF232A36</Color>
    <Color x:Key="TextColor">#FFE6E9EF</Color>
    <Color x:Key="MutedColor">#FF8A94A6</Color>
    <Color x:Key="AccentColor">#FF38BDF8</Color>
    <Color x:Key="AccentDeepColor">#FF0EA5E9</Color>
    <Color x:Key="SuccessColor">#FF34D399</Color>
    <Color x:Key="WarnColor">#FFFBBF24</Color>
    <Color x:Key="SubtleColor">#FF1B2230</Color>
    <Color x:Key="TrackColor">#FF232A36</Color>
    <Color x:Key="CheckBgColor">#FF12161E</Color>
    <Color x:Key="CheckBorderColor">#FF39404E</Color>
    <Color x:Key="OnAccentColor">#FF06121C</Color>
    <Color x:Key="ScrollThumbColor">#FF2B333F</Color>
    <Color x:Key="DisabledBgColor">#FF2A3342</Color>
    <Color x:Key="DisabledTextColor">#FF6B7688</Color>
    <Color x:Key="AccentSoftColor">#3322D3EE</Color>
    <Color x:Key="SuccessSoftColor">#3322C55E</Color>
    <Color x:Key="WarnSoftColor">#33F59E0B</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}"/>
    <SolidColorBrush x:Key="CheckBgBrush" Color="{StaticResource CheckBgColor}"/>
    <SolidColorBrush x:Key="CheckBorderBrush" Color="{StaticResource CheckBorderColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="ThumbFillBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="DisabledBgBrush" Color="{StaticResource DisabledBgColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
</ResourceDictionary>
