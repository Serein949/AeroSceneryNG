<Window x:Class="AeroSceneryNG.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:AeroSceneryNG.UI"
        Title="AeroScenery NG"
        Height="920" Width="1560" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF38BDF8" Offset="0"/>
                                <GradientStop Color="#FF22D3EE" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="A" FontWeight="Bold" FontSize="15" Foreground="#FF06121C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AeroScenery" Margin="11,0,0,0" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="NG" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="7,2" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="2.32" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <TextBlock Text="{ui:Tr Key='Aerofly FS 4 / FS Global 地景生成器'}" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeTip}">
                        <TextBlock Text="{Binding ThemeIcon}" FontSize="15" FontFamily="Segoe UI Symbol"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="{ui:Tr Key='设置与密钥'}">
                        <TextBlock Text="⚙" FontSize="15" FontFamily="Segoe UI Symbol"/>
                    </Button>
                    <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="6,0"/>
                    <Button Style="{StaticResource IconButton}" Click="Minimise_Click" ToolTip="{ui:Tr Key='最小化'}">
                        <Rectangle Width="10" Height="1" Fill="{DynamicResource MutedBrush}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Maximise_Click" ToolTip="{ui:Tr Key='最大化'}">
                        <Rectangle Width="10" Height="10" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" RadiusX="1.5" RadiusY="1.5"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="{ui:Tr Key='关闭'}">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid x:Name="ConfigView" Grid.Row="1">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ConfigTranslate" Y="0"/>
            </Grid.RenderTransform>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTaskView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="404"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="18,16,18,10" ClipToBounds="True">
                        <StackPanel>

                            <!-- 1 · selection -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{ui:Tr Key='1  选择制作区域'}" Style="{StaticResource SectionLabel}" Margin="0"/>
                                <TextBlock Text="{ui:Tr Key='单击网格 · 拖拽批量'}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Style="{StaticResource Card}" Padding="13,11" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectionText}" FontSize="12" LineHeight="19"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="{Binding SelectionGridText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="−" Style="{StaticResource MiniButton}" Command="{Binding GridLevelMinusCommand}" ToolTip="{ui:Tr Key='降低微调网格'}"/>
                                            <TextBlock Text="{Binding GridLevelText}" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                            <Button Content="+" Style="{StaticResource MiniButton}" Command="{Binding GridLevelPlusCommand}" ToolTip="{ui:Tr Key='提高微调网格'}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock Text="{Binding EstimateText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <Button Content="{ui:Tr Key='清除'}" Style="{StaticResource GhostButton}" Padding="9,3" FontSize="11"
                                                HorizontalAlignment="Right" Command="{Binding ClearSelectionCommand}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding CompletedText}" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 2 · source and target -->
                            <TextBlock Text="{ui:Tr Key='2  影像图源与目标'}" Style="{StaticResource SectionLabel}"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Height="196">
                                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" CornerRadius="7" Padding="10,7" Margin="3,2"
                                                                Background="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                        <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="4" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsChinaFriendly, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{ui:Tr Key='国内'}" FontSize="9" Foreground="{DynamicResource SuccessBrush}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="4" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding RequiresKey, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{ui:Tr Key='密钥'}" FontSize="9" Foreground="{DynamicResource WarnBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayDescription}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="✓" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="3" Margin="0,10,0,4">
                                <UniformGrid Columns="3">
                                    <RadioButton GroupName="Target" Style="{StaticResource SegmentRadio}" IsChecked="{Binding TargetFs4}" Content="{ui:Tr Key='电脑 FS4'}"/>
                                    <RadioButton GroupName="Target" Style="{StaticResource SegmentRadio}" IsChecked="{Binding TargetFsg}" Content="{ui:Tr Key='手机 FSG'}"/>
                                    <RadioButton GroupName="Target" Style="{StaticResource SegmentRadio}" IsChecked="{Binding TargetBoth}" Content="{ui:Tr Key='两者都要'}"/>
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{Binding TargetHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,0,0,4"/>
                            <CheckBox Style="{StaticResource FlatCheck}" Content="{ui:Tr Key='同时生成地形高程（DEM，电脑版）'}" IsChecked="{Binding GenerateElevation}" Margin="2,4,0,0"/>
                            <TextBlock Text="{ui:Tr Key='Level 10 · 输出到 scenery/elevation 目录，需勾选安装才会复制进游戏'}" Style="{StaticResource Muted}"
                                       FontSize="10" TextWrapping="Wrap" Margin="26,3,0,14"/>

                            <!-- 3 · levels -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{ui:Tr Key='3  输出级别'}" Style="{StaticResource SectionLabel}" Margin="0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{ui:Tr Key='全选'}" Style="{StaticResource GhostButton}" Padding="7,2" FontSize="10.5"
                                            Command="{Binding UseAllLevelsCommand}"/>
                                    <Button Content="{ui:Tr Key='清空'}" Style="{StaticResource GhostButton}" Padding="7,2" FontSize="10.5" Margin="5,0,0,0"
                                            Command="{Binding UseNoLevelsCommand}"/>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Layers}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6" IsEnabled="{Binding IsEnabled}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.35"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource FlatCheck}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="7,1,0,0"/>
                                                </StackPanel>
                                            </CheckBox>
                                            <Border Grid.Column="1" Background="{DynamicResource SubtleBrush}" CornerRadius="7" Padding="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="−" Style="{StaticResource MiniButton}" Command="{Binding ZoomOutCommand}" ToolTip="{ui:Tr Key='降低该级别的影像细节'}"/>
                                                    <Button Content="{Binding ZoomText}" Style="{StaticResource GhostButton}" Width="52" Height="24" Padding="0"
                                                            FontSize="10.5" BorderThickness="0" Background="Transparent"
                                                            Command="{Binding AutoZoomCommand}" ToolTip="{ui:Tr Key='清除本级覆盖，跟随全局 ZL 或 Level + 3'}"/>
                                                    <Button Content="+" Style="{StaticResource MiniButton}" Command="{Binding ZoomInCommand}" ToolTip="{ui:Tr Key='提高该级别的影像细节'}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- global detail -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{ui:Tr Key='统一影像细节'}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding ZoomHint}" Style="{StaticResource Muted}" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                            <Slider Style="{StaticResource FlatSlider}" Minimum="10" Maximum="19" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding ImageZoom}" IsEnabled="{Binding SliderEnabled}"/>
                            <CheckBox Style="{StaticResource FlatCheck}" Content="{ui:Tr Key='统一自动匹配（未单独设置的级别）'}" IsChecked="{Binding UseAutoZoom}" Margin="0,6,0,16"/>

                            <!-- 4 · options -->
                            <TextBlock Text="{ui:Tr Key='4  生成选项'}" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}" Padding="13,11">
                                <StackPanel>
                                    <TextBlock Text="{ui:Tr Key='地景名称'}" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                                    <TextBox Style="{StaticResource FlatTextBox}" Text="{Binding SceneryName, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="{ui:Tr Key='下载线程'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadThreadsText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Grid>
                                    <Slider Style="{StaticResource FlatSlider}" Minimum="4" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True"
                                            Value="{Binding DownloadThreads}"/>

                                    <CheckBox Style="{StaticResource FlatCheck}" Content="{ui:Tr Key='跳过已存在的瓦片（断点续作）'}" IsChecked="{Binding SkipExisting}" Margin="0,10,0,0"/>
                                    <CheckBox Style="{StaticResource FlatCheck}" Content="{ui:Tr Key='LZHAM 压缩（官方格式，体积更小）'}" IsChecked="{Binding UseLzham}" Margin="0,8,0,0"/>
                                    <CheckBox Style="{StaticResource FlatCheck}" Content="{ui:Tr Key='自动打包为 TME（手机版）'}" IsChecked="{Binding PackageTme}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{ui:Tr Key='输出目录'}" Style="{StaticResource SectionLabel}" Margin="0,14,0,7"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9,7">
                                    <TextBlock Text="{Binding OutputDirectory}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Button Grid.Column="1" Content="{ui:Tr Key='浏览'}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="10,6"
                                        Command="{Binding BrowseOutputCommand}"/>
                            </Grid>

                            <CheckBox Style="{StaticResource FlatCheck}" IsChecked="{Binding InstallIntoScenery}" Margin="0,12,0,6"
                                      Content="{ui:Tr Key='完成后自动安装到 Aerofly FS 4 场景目录'}"/>

                            <Button Content="{ui:Tr Key='打开输出目录'}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Command="{Binding OpenOutputCommand}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action footer -->
                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12,18,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/>
                                <TextBlock Text="{Binding DetailMessage}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource FlatProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,0,0,11"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="{ui:Tr Key='开始生成'}" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"/>
                                <Button Grid.Column="1" Content="{ui:Tr Key='取消'}" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                        Command="{Binding CancelCommand}" Height="44" Padding="18,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Map -->
            <Grid Grid.Column="1" Background="{DynamicResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" ClipToBounds="True">
                    <Grid>
                        <ContentControl x:Name="MapHost" Focusable="False"/>

                        <!-- floating hint -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,8"
                                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Opacity="0.94">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◫" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{ui:Tr Key='左键拖拽框选 · 单击网格微调 · 右键平移 · 滚轮缩放'}" Margin="8,0,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- zoom controls -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Padding="3"
                                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <Button Content="+" Style="{StaticResource IconButton}" Click="ZoomIn_Click" ToolTip="{ui:Tr Key='放大'}"/>
                                <Button Content="−" Style="{StaticResource IconButton}" Click="ZoomOut_Click" ToolTip="{ui:Tr Key='缩小'}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="14,0">
                        <TextBlock x:Name="CursorLabel" Text="—" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ZoomLabel" Text="Z11" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{ui:Tr Key='AeroScenery NG · 多线程下载 · LZHAM / ETC2'}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Task detail page -->
        <Grid x:Name="TaskView" Grid.Row="1" Panel.ZIndex="20" Background="{DynamicResource BgBrush}" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TaskTranslate" Y="14"/>
            </Grid.RenderTransform>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTaskView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid Margin="28,20,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{ui:Tr Key='←  返回配置'}" Style="{StaticResource GhostButton}" Padding="14,6"
                                Command="{Binding ShowConfigCommand}"/>
                        <TextBlock Text="{ui:Tr Key='任务详情'}" Style="{StaticResource H1}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="10,4" Margin="14,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TaskStatus}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding TaskStage}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="372"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- progress hero -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TaskPercentText}" FontSize="46" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" MinWidth="130"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TaskStage}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding TaskCurrentText}" Style="{StaticResource Muted}" Margin="0,3,0,10"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Style="{StaticResource FlatProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="1"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- phase timeline -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                            <UniformGrid Columns="4">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TaskStageIndex}" Value="0">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="1" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                    <TextBlock Text="{ui:Tr Key='准备'}" FontSize="10.5" Margin="0,6,0,0" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TaskStageIndex}" Value="1">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="2" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                    <TextBlock Text="{ui:Tr Key='下载与转换'}" FontSize="10.5" Margin="0,6,0,0" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TaskStageIndex}" Value="2">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="3" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                    <TextBlock Text="{ui:Tr Key='安装与打包'}" FontSize="10.5" Margin="0,6,0,0" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TaskStageIndex}" Value="3">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="✓" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                    <TextBlock Text="{ui:Tr Key='完成'}" FontSize="10.5" Margin="0,6,0,0" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- live stats -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{ui:Tr Key='下载影像'}" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                                    <TextBlock Text="{Binding TaskDownloadText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding TaskSpeedText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,14" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{ui:Tr Key='转换纹理'}" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                                    <TextBlock Text="{Binding TaskConvertText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding TaskElapsedText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- log -->
                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{ui:Tr Key='实时日志'}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                <ListBox x:Name="TaskLogList" Grid.Row="1" ItemsSource="{Binding TaskLogs}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0,1"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10.5"
                                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- right column -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{ui:Tr Key='任务信息'}" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding TaskInfoText}" FontSize="11.5" LineHeight="22"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>

                            <TextBlock Text="{ui:Tr Key='当前处理'}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding TaskCurrentText}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,16"/>

                            <Button Content="{ui:Tr Key='打开输出目录'}" Style="{StaticResource PrimaryButton}" Height="40"
                                    Command="{Binding OpenTaskOutputCommand}" Margin="0,0,0,8"/>
                            <Button Content="{ui:Tr Key='取消任务'}" Style="{StaticResource GhostButton}" Height="38"
                                    Command="{Binding CancelCommand}" Margin="0,0,0,8"/>
                            <Button Content="{ui:Tr Key='重新生成'}" Style="{StaticResource GhostButton}" Height="38"
                                    Command="{Binding StartCommand}" Margin="0,0,0,8"/>
                            <Button Content="{ui:Tr Key='返回配置'}" Style="{StaticResource GhostButton}" Height="38"
                                    Command="{Binding ShowConfigCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
