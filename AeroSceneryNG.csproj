<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AeroSceneryNG</RootNamespace>
    <AssemblyName>AeroSceneryNG</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.32.0</Version>
    <FileVersion>2.32.0.0</FileVersion>
    <AssemblyVersion>2.32.0.0</AssemblyVersion>
    <Company>AeroScenery NG</Company>
    <Product>AeroScenery NG</Product>
    <Description>AeroFly FS4 / FS Global scenery generator</Description>
    <Copyright>Copyright © 2026 AeroScenery NG</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Cli\**\*.cs" />
    <Compile Remove="AeroSceneryMobile\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>
</Project>
